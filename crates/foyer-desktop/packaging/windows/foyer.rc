// Icon and version info for Foyer.exe. build.rs defines FOYER_VERSION
// ("0.1.0"), FOYER_VERSION_NUMBERS (0,1,0,0) and FOYER_ICON (the path to
// packaging/icon.ico).
#include <winver.h>

1 ICON FOYER_ICON

VS_VERSION_INFO VERSIONINFO
FILEVERSION FOYER_VERSION_NUMBERS
PRODUCTVERSION FOYER_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Foyer"
            VALUE "FileDescription", "Foyer"
            VALUE "FileVersion", FOYER_VERSION
            VALUE "InternalName", "Foyer"
            VALUE "OriginalFilename", "Foyer.exe"
            VALUE "ProductName", "Foyer"
            VALUE "ProductVersion", FOYER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
